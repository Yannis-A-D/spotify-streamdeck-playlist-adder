{
  "name": "spotify-streamdeck-playlist-adder",
  "version": "1.0.0",
  "description": "Stream Deck plugin to add the currently playing Spotify song to a chosen playlist with deduplication check.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.spotify-playlist-adder\"",
    "pack": "streamdeck pack com.spotify-playlist-adder.sdPlugin --force"
  },
  "keywords": [
    "streamdeck",
    "elgato",
    "spotify",
    "playlist"
  ],
  "author": "Yannis",
  "license": "MIT",
  "devDependencies": {
    "@elgato/cli": "^1.5.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.14.0",
    "rollup": "^4.22.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.2"
  }
}
